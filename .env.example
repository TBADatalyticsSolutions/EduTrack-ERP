# ==================================================
# LOCAL DEVELOPMENT
# ==================================================

DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-development-secret-key

# Development database.
# Keep production/Render credentials out of committed files.
DB_ENGINE=postgresql
DB_NAME=edutrack_erp
DB_USER=postgres
DB_PASSWORD=replace-with-local-postgres-password
DB_LOCAL_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True
DB_SSL_REQUIRE=False


# ==================================================
# LOCAL AUTOMATED TESTING
# ==================================================
#
# IMPORTANT:
# Django tests must NEVER use the Render/shared database.
# These settings point the test runner to the local PostgreSQL
# 18 service. The PostgreSQL user must have permission to create
# and drop test databases.
#
# Django will use DB_TEST_DATABASE_NAME as the test database.

DB_TEST_NAME=edutrack_erp_local
DB_TEST_USER=postgres
DB_TEST_PASSWORD=replace-with-local-postgres-password
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=5432
DB_TEST_DATABASE_NAME=edutrack_erp_local_test
DB_TEST_SSL_REQUIRE=False


# ==================================================
# PRODUCTION / RENDER
# ==================================================
#
# Set these in Render environment variables, not in a committed .env file.

# DJANGO_ENV=production
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<generate-a-secret>
# DJANGO_ALLOWED_HOSTS=<your-render-host>
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<your-render-host>
# DB_ENGINE=postgresql
# DB_NAME=edutrack_erp
# DB_USER=<postgres-user>
# DB_PASSWORD=<postgres-password>
# DB_HOST=<postgres-host>
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
# DB_CONN_HEALTH_CHECKS=True
# DB_SSL_REQUIRE=True
