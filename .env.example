# Local development
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-development-secret-key

DB_NAME=Edutrack_erp
DB_USER=root
DB_PASSWORD=replace-with-local-mysql-password
DB_LOCAL_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Production (set these in Render, not in a committed .env file)
# DJANGO_ENV=production
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<generate-a-secret>
# DJANGO_ALLOWED_HOSTS=<your-render-host>
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<your-render-host>
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=<aiven-password>
# DB_HOST=<aiven-host>
# DB_PORT=<aiven-port>
# DB_SSL_CA=/opt/render/project/src/certs/aiven-ca.pem
